alias gsw='git switch'
alias gswm='git switch $(git_master_branch)'
alias gswd='git switch $(git_dev_branch)'

function git_dev_branch() {
	command git rev-parse --git-dir &>/dev/null || return
	local branch
	for branch in dev devel develop development; do
		if command git show-ref -q --verify refs/heads/$branch; then
			echo $branch
			return 0
		fi
	done

	echo dev
	return 1
}

# Get the default branch name from common branch names or fallback to remote HEAD
function git_master_branch() {
	command git rev-parse --git-dir &>/dev/null || return

	local remote ref

	# omz's original: {main,trunk,mainline,default,stable,master}
	for ref in refs/{heads,remotes/{origin,upstream}}/{master,main}; do
		if command git show-ref -q --verify $ref; then
			echo ${ref:t}
			return 0
		fi
	done

	# Fallback: try to get the default branch from remote HEAD symbolic refs
	for remote in origin upstream; do
		ref=$(command git rev-parse --abbrev-ref $remote/HEAD 2>/dev/null)
		if [[ $ref == $remote/* ]]; then
			echo ${ref#"$remote/"}
			return 0
		fi
	done

	# If no main branch was found, fall back to master but return error
	echo master
	return 1
}

